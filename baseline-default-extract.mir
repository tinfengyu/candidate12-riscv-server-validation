--- |
  ; ModuleID = '/home/tinfeng/llvm-project/investigation-candidate12-hardware/package/extract.ll'
  source_filename = "/home/tinfeng/llvm-project/investigation-candidate12-hardware/package/extract.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64-unknown-linux-gnu"
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare i64 @llvm.riscv.vmv.x.s.nxv1i64(<vscale x 1 x i64>) #0
  
  define i64 @candidate12_extract(<vscale x 1 x i64> %x, <vscale x 1 x i64> %y, i1 %cond, i64 %vl, ptr %p) #1 {
  entry:
    br i1 %cond, label %then, label %else
  
  then:                                             ; preds = %entry
    %a = call <vscale x 1 x i64> @llvm.riscv.vadd.nxv1i64.nxv1i64.i64(<vscale x 1 x i64> poison, <vscale x 1 x i64> %x, <vscale x 1 x i64> %y, i64 %vl)
    call void @llvm.riscv.vse.nxv1i64.p0.i64(<vscale x 1 x i64> %a, ptr %p, i64 %vl)
    br label %join
  
  else:                                             ; preds = %entry
    %b = call <vscale x 1 x i64> @llvm.riscv.vsub.nxv1i64.nxv1i64.i64(<vscale x 1 x i64> poison, <vscale x 1 x i64> %x, <vscale x 1 x i64> %y, i64 7)
    call void @llvm.riscv.vse.nxv1i64.p0.i64(<vscale x 1 x i64> %b, ptr %p, i64 7)
    br label %join
  
  join:                                             ; preds = %else, %then
    %v = phi <vscale x 1 x i64> [ %a, %then ], [ %b, %else ]
    %out = call i64 @llvm.riscv.vmv.x.s.nxv1i64(<vscale x 1 x i64> %v)
    ret i64 %out
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <vscale x 1 x i64> @llvm.riscv.vadd.nxv1i64.nxv1i64.i64(<vscale x 1 x i64>, <vscale x 1 x i64>, <vscale x 1 x i64>, i64) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
  declare <vscale x 1 x i64> @llvm.riscv.vsub.nxv1i64.nxv1i64.i64(<vscale x 1 x i64>, <vscale x 1 x i64>, <vscale x 1 x i64>, i64) #0
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: write)
  declare void @llvm.riscv.vse.nxv1i64.p0.i64(<vscale x 1 x i64>, ptr captures(none), i64) #2
  
  attributes #0 = { nocallback nofree nosync nounwind willreturn memory(none) "target-features"="+m,+a,+f,+d,+v,-c" }
  attributes #1 = { "target-features"="+m,+a,+f,+d,+v,-c" }
  attributes #2 = { nocallback nofree nosync nounwind willreturn memory(argmem: write) "target-features"="+m,+a,+f,+d,+v,-c" }
  
  !llvm.module.flags = !{!0}
  
  !0 = !{i32 1, !"target-abi", !"lp64d"}
...
---
name:            candidate12_extract
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:
  - { id: 0, class: vr, preferred-register: '', flags: [  ] }
  - { id: 1, class: vr, preferred-register: '', flags: [  ] }
  - { id: 2, class: vr, preferred-register: '', flags: [  ] }
  - { id: 3, class: vr, preferred-register: '$v8', flags: [  ] }
  - { id: 4, class: vr, preferred-register: '$v9', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '$x10', flags: [  ] }
  - { id: 6, class: gprnox0, preferred-register: '$x11', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '$x12', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr, preferred-register: '$x10', flags: [  ] }
  - { id: 10, class: vr, preferred-register: '', flags: [  ] }
  - { id: 11, class: vr, preferred-register: '', flags: [  ] }
  - { id: 12, class: vr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$v8', virtual-reg: '%3' }
  - { reg: '$v9', virtual-reg: '%4' }
  - { reg: '$x10', virtual-reg: '%5' }
  - { reg: '$x11', virtual-reg: '%6' }
  - { reg: '$x12', virtual-reg: '%7' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $v8, $v9, $x10, $x11, $x12
  
    %7:gpr = COPY $x12
    %5:gpr = COPY $x10
    %8:gpr = ANDI %5, 1
    %6:gprnox0 = COPY $x11
    BEQ %8, $x0, %bb.2
    PseudoBR %bb.1
  
  bb.1.then:
    successors: %bb.3(0x80000000)
    liveins: $v8, $v9
  
    dead $x0 = PseudoVSETVLI %6, 216 /* e64, m1, ta, ma */, implicit-def $vl, implicit-def $vtype
    renamable $v8 = PseudoVADD_VV_M1 undef renamable $v8, killed renamable $v8, killed renamable $v9, $noreg /* vl */, 6 /* e64 */, 0 /* tu, mu */, implicit $vl, implicit $vtype
    PseudoVSE64_V_M1 renamable $v8, %7, $noreg /* vl */, 6 /* e64 */, implicit $vl, implicit $vtype :: (store unknown-size into %ir.p, align 8)
    PseudoBR %bb.3
  
  bb.2.else:
    successors: %bb.3(0x80000000)
    liveins: $v8, $v9
  
    dead $x0 = PseudoVSETIVLI 7, 216 /* e64, m1, ta, ma */, implicit-def $vl, implicit-def $vtype
    renamable $v8 = PseudoVSUB_VV_M1 undef renamable $v8, killed renamable $v8, killed renamable $v9, 7 /* vl */, 6 /* e64 */, 0 /* tu, mu */, implicit $vl, implicit $vtype
    PseudoVSE64_V_M1 renamable $v8, %7, 7 /* vl */, 6 /* e64 */, implicit $vl, implicit $vtype :: (store unknown-size into %ir.p, align 8)
  
  bb.3.join:
    liveins: $v8
  
    dead $x0 = PseudoVSETIVLI 1, 216 /* e64, m1, ta, ma */, implicit-def $vl, implicit-def $vtype
    %9:gpr = PseudoVMV_X_S killed renamable $v8, 6 /* e64 */, implicit $vtype
    $x10 = COPY %9
    PseudoRET implicit $x10
...
